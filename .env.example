# Copia a .env.local (nunca se versiona). En Vercel, define las mismas para Production y Preview.
# Las que dicen "fase N" se crean cuando esa fase las pida (ver CLAUDE.md).

# Base de datos (Neon, creada desde Vercel). Local y previews: rama dev. Produccion: rama main.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (fase 2): BETTER_AUTH_SECRET se genera con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob (fase 3, imagenes y PDFs del CV)
BLOB_READ_WRITE_TOKEN=

# Resend (fase 4, formulario de contacto). Dominio verificado: mateojaras.dev
RESEND_API_KEY=
CONTACT_TO_EMAIL=mateojaras@gmail.com

# Upstash Redis (fase 4, rate limit del formulario)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cal.com (fase 4)
NEXT_PUBLIC_CAL_URL=

# Analytics (fase 5): vacio si usas Vercel Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Backlog: borradores de traduccion en el admin
ANTHROPIC_API_KEY=
