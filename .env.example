# Copia a .env.local (nunca se versiona). En Vercel, define las mismas para Production y Preview.
# Las que dicen "fase N" se crean cuando esa fase las pida (ver CLAUDE.md).

# Base de datos (Neon, creada desde Vercel). Local y previews: rama dev. Produccion: rama main.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (fase 2): BETTER_AUTH_SECRET se genera con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob (fase 3, imagenes y PDFs del CV)
# Si el store usa OIDC, Vercel anade ademas BLOB_STORE_ID y BLOB_WEBHOOK_PUBLIC_KEY solo.
# El codigo pasa BLOB_READ_WRITE_TOKEN de forma explicita en cada llamada.
BLOB_READ_WRITE_TOKEN=

# Resend (fase 4, formulario de contacto). Dominio verificado: mateojaras.dev
# From: mateojaras.dev <contacto@mateojaras.dev>, To: site_settings.email
# Producción y Preview (D-22). CI no la tiene: el contacto falla cerrado
RESEND_API_KEY=

# Upstash Redis (fase 4, rate limit del formulario)
# Tambien se aceptan KV_REST_API_URL y KV_REST_API_TOKEN (nombres del Marketplace de Vercel).
# Con la integración de Vercel Marketplace llegan como KV_REST_API_URL y KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics: Vercel Web Analytics, sin variables (fase 5)

# Backlog: borradores de traduccion en el admin
ANTHROPIC_API_KEY=

# Solo el seed (nunca en Vercel): credenciales del único admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
